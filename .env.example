# ===================================
# A股自選股智能分析系統 - 環境變量配置模板
# 複製此文件為 .env 並填入真實配置
# ===================================

# 自選股列表（逗號分隔，支持滬深兩市代碼）
# 滬市：600xxx, 601xxx, 603xxx
# 深市：000xxx, 002xxx, 300xxx
STOCK_LIST=600519,300750,002594

# Futu OpenD（持倉導入）
# --portfolio futu 只讀取 ACTIVE REAL NORMAL / MASTER 賬戶中的滬深 A 股、港股、美股 LONG 正股持倉。
# futu-api 10.8 僅支持 IPv4；Docker 連接宿主機 OpenD 時請勿使用容器內的 127.0.0.1，詳見 docs/full-guide.md。
# FUTU_OPEND_HOST=127.0.0.1
# FUTU_OPEND_PORT=11111
# FUTU_HK_REALTIME_SOURCE_PRIORITY=futu,longbridge,akshare,yfinance
# FUTU_SECURITY_FIRM=NONE          # 可選；默認由 OpenD 自動識別，也可顯式指定券商
# FUTU_ACC_ID=                    # 可選；正整數，指定後只讀取該真實賬戶

# 數據源配置
# Tushare Pro Token（可選，從 https://tushare.pro/weborder/#/login?reg=834638 獲取）
TUSHARE_TOKEN=
# Tushare Pro 自定義接入地址（可選，默認 http://api.tushare.pro）
# 適用場景：網絡無法直達官方接口時指向自建網關或第三方兼容鏡像
# 注意：使用非官方接入地址時，Token 與全部請求內容會經過該第三方服務器，請自行評估數據安全風險
# 必須以 http:// 或 https:// 開頭；留空則保持官方默認地址不變
# TUSHARE_HTTP_URL=http://api.tushare.pro
# TickFlow API Key（可選；用於 A 股日 K、實時行情、股票列表/名稱與大盤覆盤增強，權限不足自動回退）
# TICKFLOW_API_KEY=
# TICKFLOW_KLINE_ADJUST=none          # none/forward/backward/forward_additive/backward_additive
# TICKFLOW_BATCH_DAILY_ENABLED=true   # 有權限時通過 TickFlow 批量預取日 K
# TICKFLOW_BATCH_SIZE=100             # TickFlow 單次批量請求的最大標的數
# 妙想（東方財富 MX_API）API Key —— 嚴格 opt-in 的第三方能力：需用戶自備 Key（妙想 Skills 頁面獲取），
# 當前限時免費/會員配額策略可能調整，不承諾長期免費；未配置時系統行為完全不變。
# 配置後：在東財公開接口被限流時兜底獲取籌碼分佈與個股資金流。
# MX_APIKEY=
# MX_PRIORITY=6                       # 妙想數據源優先級，默認 6（位於內置數據源之後）

# 選股（參考 AlphaSift 實現，默認關閉；通常由 Web“基礎設置”中的選股開關維護）
SCREENING_ENABLED=false
# 全市場快照源優先級；未配置時 DSA 會按是否配置 TUSHARE_TOKEN 自動注入：
# - 有 TUSHARE_TOKEN：tushare,sina,efinance,akshare_em,em_datacenter
# - 無 TUSHARE_TOKEN：sina,efinance,akshare_em,em_datacenter
# SNAPSHOT_SOURCE_PRIORITY=tushare,sina,efinance,akshare_em,em_datacenter
# （若希望保持與運行時自動注入一致，建議僅留空，不在該文件中固定值）
# 選股第三方數據源調用超時護欄。
# - SCREENING_SOURCE_CALL_TIMEOUT_SEC 為全局兜底；設為 0/off/disabled 可關閉 caller-side timeout。
# - Hotspot/SNAPSHOT/Daily 專項值優先於全局值；默認分別為 8s / 60s / 20s。
# - 熱點默認 provider 會把正數值作為單次板塊/成分股/詳情 fallback 調用預算，並將剩餘時間傳入可終止的
#   AkShare 子進程和 HTTP socket；0/off 只關閉整次調用預算，單源硬超時仍保留。
# SCREENING_SOURCE_CALL_TIMEOUT_SEC=
# SCREENING_HOTSPOT_CALL_TIMEOUT_SEC=8
# 用戶主動搜索熱點消息時的端到端等待上限，覆蓋緩存 owner 等待和 provider 執行。
# 該路徑必須有可終止子進程硬截止，0/off 會回退到安全默認值 12 秒。
# SCREENING_HOTSPOT_SEARCH_TIMEOUT_SEC=12
# SCREENING_SNAPSHOT_CALL_TIMEOUT_SEC=60
# SCREENING_DAILY_CALL_TIMEOUT_SEC=20
# 選股的東財直連請求限速與隨機抖動。
# SCREENING_EASTMONEY_MIN_INTERVAL_SEC=1.0
# SCREENING_EASTMONEY_JITTER_SEC=0.3
# 選股支持 last-good 快照、日線歷史和行業/概念 provider 緩存，默認目錄為 data/screening。
# 如需自定義，可覆蓋以下路徑；留空不會改寫既有 DSA 配置。
# SCREENING_DATA_DIR=data/screening
# SCREENING_FALLBACK_SNAPSHOT_PATH=data/screening/snapshot.last_good.json
# 5 分鐘內重複選股默認複用最近一次成功的全市場快照；設為 0 可關閉。
# SCREENING_SNAPSHOT_CACHE_TTL_SEC=300
# SCREENING_DAILY_HISTORY_CACHE_DIR=data/screening/daily_history
# 日線緩存默認 TTL 24 小時，且須覆蓋最新已收盤交易日；收盤前緩存跨收盤時會刷新。
# 日曆不可用時保持 TTL 判斷；刷新失敗時舊日線會進入質量評分與風險懲罰。
# SCREENING_INDUSTRY_PROVIDER_CACHE_DIR=data/screening/industry_provider_cache
# 選股的行業/概念 provider 默認關閉；開啟 akshare 後可為 theme_heat、行業熱度和 LLM 上下文提供更多板塊信息。
# INDUSTRY_PROVIDER=none
# INDUSTRY_PROVIDER_MAX_BOARDS=80
# 單次 LLM 請求超時秒數；選股會複用該配置，超時後降級返回非 LLM 排序結果。
# LLM_TIMEOUT_SEC=60
# 選股 LLM 重排請求輸出上限，默認 2048。
# LLM_MAX_TOKENS=2048

# Finnhub（可選，美股數據源，免費 tier 60 calls/min）
# 獲取: https://finnhub.io/register
# FINNHUB_API_KEY=

# AlphaVantage（可選，美股數據源，免費 tier 25 calls/day）
# 獲取: https://www.alphavantage.co/support/#api-key
# ALPHAVANTAGE_API_KEY=

# Longbridge OpenAPI（可選，美股/港股量比、換手率、PE 等字段兜底）
# 從 https://open.longbridge.com/ 獲取
# OAuth 2.0（推薦）：先運行 scripts/generate_longbridge_oauth_token.py 生成本機 SDK token 緩存
# client_id 優先取 LONGBRIDGE_OAUTH_CLIENT_ID；留空且沒有 Legacy Access Token 時兼容使用 LONGBRIDGE_APP_KEY
# GitHub Actions / Docker 可把 token 緩存文件 base64 後填入 LONGBRIDGE_OAUTH_TOKEN_CACHE_B64
# LONGBRIDGE_OAUTH_CLIENT_ID=
# LONGBRIDGE_OAUTH_TOKEN_CACHE_B64=
# Legacy API Key（兼容舊賬號；Access Token 不是 OAuth access token）
# LONGBRIDGE_APP_KEY=
# LONGBRIDGE_APP_SECRET=
# LONGBRIDGE_ACCESS_TOKEN=
# static_info 進程內緩存秒數，默認 86400；0=每次請求拉取
# LONGBRIDGE_STATIC_INFO_TTL_SECONDS=86400
# 連接關閉類異常後的冷卻秒數，默認 15；冷卻期內會臨時跳過 Longbridge，避免請求級頻繁重連
# LONGBRIDGE_CONNECTION_COOLDOWN_SECONDS=15
# Longbridge SDK 語言與 REPORT_LANGUAGE（zh/en）一致；SDK 日誌寫入 LOG_DIR/longbridge_sdk.log
# 接入點（與 REPORT_LANGUAGE 無關；留空則用下列默認值）：
# LONGBRIDGE_HTTP_URL=https://openapi.longbridge.com
# LONGBRIDGE_QUOTE_WS_URL=wss://openapi-quote.longbridge.com/v2
# LONGBRIDGE_TRADE_WS_URL=wss://openapi-trade.longbridge.com/v2
# LONGBRIDGE_REGION=hk
# 覆蓋接入點；SDK 內部用 LONGPORT_REGION（不帶 BRIDGE）自動選擇，
# 代碼會自動同步 LONGBRIDGE_REGION → LONGPORT_REGION。
# hk → *.longbridge.com  |  cn → *.longbridge.cn
# 其餘見：https://open.longbridge.com/zh-CN/docs/getting-started#環境變量
# 夜盤行情 true/false，默認 false
# LONGBRIDGE_ENABLE_OVERNIGHT=false
# K 線推送 realtime 或 confirmed，默認 realtime
# LONGBRIDGE_PUSH_CANDLESTICK_MODE=realtime
# 連接時是否打印行情包（與 README / full-guide 一致：未設置時應用側默認為關閉，等同 false）
# 設為 1 / true / yes 開啟 SDK 詳細行情包日誌（調試長橋連接時使用）
# LONGBRIDGE_PRINT_QUOTE_PACKAGES=false

# 股票自動補全索引遠程更新（默認開啟；GitHub 不可訪問時自動降級到本地內置索引）
STOCK_INDEX_REMOTE_UPDATE_ENABLED=true

# ===================================
# AI 模型配置
# ===================================
# 完整說明：docs/LLM_CONFIG_GUIDE.md
#
# 【快速上手】選擇一種模型接入方式，搜索 Key 獨立配置。
#   Modelflare（OpenAI Compatible）→ 只需填寫 MODELFLARE_KEY，自動使用默認地址和模型
#   Gemini（免費額度）→ 填 GEMINI_API_KEY
#   DeepSeek（性價比高）→ 填 DEEPSEEK_API_KEY
#   AIHubmix（聚合平臺）→ 填 AIHUBMIX_KEY
#
# 【進階】需要多模型 / 多平臺 fallback → 配置下方「多渠道」或在 Web 設置頁可視化管理。
# 每個渠道可通過 LLM_<CHANNEL>_API_SURFACE 顯式選擇 chat_completions（默認）或 responses。
# responses 要求 PROTOCOL=openai，且 MODELS 中不能使用 anthropic/、gemini/、xai/ 等 LiteLLM 直連 provider 前綴；
# 網關自有的帶斜槓模型 ID（如 deepseek-ai/DeepSeek-V3）會作為 OpenAI-compatible 模型 ID 路由。
# 同一個規範化模型別名不能同時出現在 chat_completions 和 responses 渠道；需要兩種 Surface 時請使用不同別名。
# 同一渠道中的模型必須使用同一種 API Surface；不要依賴失敗後自動切換 endpoint。
# 若 Anspire `/models` 與連接測試確認目標模型走 Responses（例如當前觀測到的 GPT-5.6 sol/terra/luna），使用渠道模式並設置 LLM_ANSPIRE_API_SURFACE=responses。
# ===================================

# 生成後端：默認 litellm；codex_cli / claude_code_cli / opencode_cli 為顯式 opt-in 的本地 CLI backend（experimental/limited）。
# OpenCode CLI 使用本機 OpenCode 的默認模型；OPENCODE_CLI_MODEL 只是可選 --model 覆蓋。
# 本地 CLI Backend 不等於離線模型，CLI 背後的服務可能處理股票代碼、新聞、持倉上下文、分析 prompt 和報告草稿。
# Docker / CI / remote server 不天然擁有桌面 CLI 登錄態；DSA 不讀取 Claude/OpenCode credential 文件。
# DSA 會用最小 env allowlist + provider credential denylist 降低 API keys / webhook tokens 洩漏風險。
# Web 設置頁的快速檢查只讀配置和可執行文件可見性；JSON 測試才會發起真實 generation backend smoke 請求。
GENERATION_BACKEND=litellm
# OPENCODE_CLI_MODEL=provider/model
# 後端級 fallback；本地 .env 空值禁用 backend-level fallback，litellm -> litellm 會被解析為 no-op。
# 默認 GitHub Actions workflow 未配置該變量時會顯式使用 litellm；Actions 中要禁用 fallback 時可設為 primary backend 實現 self no-op。
GENERATION_FALLBACK_BACKEND=litellm
# 本地 CLI backend 執行上限；timeout 最大 3600，輸出最大 33554432 bytes，併發最大分別為 16 / 4。
GENERATION_BACKEND_TIMEOUT_SECONDS=300
GENERATION_BACKEND_MAX_OUTPUT_BYTES=1048576
GENERATION_BACKEND_MAX_CONCURRENCY=1
LOCAL_CLI_BACKEND_MAX_CONCURRENCY=1
# 問股 Chat 運行方式；auto（推薦）和 litellm 保持默認 LiteLLM。舊 codex_app_server 已移除，須主動改為合法值；獨立 codex_cli 普通報告不受影響。
AGENT_BACKEND=auto
# 舊的 Agent 模型路由兼容項；普通用戶請在 Web 設置頁使用 AGENT_BACKEND。
AGENT_GENERATION_BACKEND=auto

# --- API Key（填一個即可）---

# Gemini（https://aistudio.google.com）
GEMINI_API_KEY=
# 多 Key 負載均衡：GEMINI_API_KEYS=key1,key2,key3

# DeepSeek（https://platform.deepseek.com）
# 默認：僅填 DEEPSEEK_API_KEY 時使用 deepseek-v4-flash
# DEEPSEEK_API_KEY=

# AIHubmix 聚合（https://inferera.com/?aff=CfMq）
# 一個 Key 用 GPT/Claude/Gemini/GLM/Qwen 等模型，無需科學上網
# AIHUBMIX_KEY=

# Anthropic Claude（https://console.anthropic.com）
# ANTHROPIC_API_KEY=

# OpenAI / 兼容 API
# OPENAI_API_KEY=
# OPENAI_BASE_URL=                     # 第三方 API 地址（中轉站/代理），留空用官方

# Ollama 本地模型（無需 API Key，推薦）
# OLLAMA_API_BASE=http://localhost:11434
# LITELLM_MODEL=ollama/qwen3:8b
#
# 或使用渠道模式：
# LLM_CHANNELS=ollama
# LLM_OLLAMA_BASE_URL=http://localhost:11434
# LLM_OLLAMA_MODELS=qwen3:8b

# 採樣溫度（0.0-2.0，默認 0.7；0 確定性最高，2 隨機性最高）
# 嚴格 temperature 兼容來源：
# - Moonshot API / 模型文檔：https://platform.kimi.ai/docs/guide/kimi-k2-6-quickstart
# - Moonshot 官方模型卡（評測默認 temperature = 1.0）：https://huggingface.co/moonshotai/Kimi-K2.6
# - OpenAI Chat Completions 規範：https://platform.openai.com/docs/api-reference/chat/create
# - LiteLLM OpenAI-Compatible 規範：https://docs.litellm.ai/docs/providers/openai_compatible
# 當前倉庫運行時依賴約束：litellm>=1.80.10,!=1.82.7,!=1.82.8,<1.99.0（顯式排除 PyPI 事故版本並將上界收斂到已驗證版本，見 requirements.txt）。
# 因此 kimi-k2.6 會自動改用 1.0/0.6；GPT-5 / o 系列等默認溫度模型會省略 temperature，避免 API 拒絕請求。
# 若兼容平臺返回明確的參數不支持錯誤，運行時會在當前請求內修正參數並重試一次；成功策略只做進程內緩存。
# top_p、presence_penalty、frequency_penalty、seed 若返回“不支持參數”，同樣會觸發本次請求級別的修正與重試（不改寫 LLM_TEMPERATURE）。
# 其他模型和 fallback 仍使用你配置的 LLM_TEMPERATURE。
# Web 設置頁 / 桌面端導入不會靜默清空或改寫 LLM_TEMPERATURE；只在真正發請求前臨時適配模型參數。
# 如果主模型切回普通模型，原本配置的溫度會自動恢復；最小回滾方式是回退本次 LLM 參數適配改動。
# LLM_TEMPERATURE=0.7

# LLM 用量遙測 message HMAC 配置（可選）
# 默認留空時，系統會在數據目錄生成 .llm_usage_hmac_secret，本地部署內可穩定比較。
# 只有需要跨部署比較 usage message HMAC 時才顯式配置同一個隨機密鑰；輪換時同步更新版本標籤。
# 顯式配置時請使用高熵隨機值（例如 openssl rand -hex 32），不要把真實密鑰提交到版本控制。
# LLM_USAGE_HMAC_SECRET=
# LLM_USAGE_HMAC_KEY_VERSION=local-v1

# Provider prompt cache 配置（可選）
# TELEMETRY 只控制 provider cache usage / diagnostics 記錄；不控制 provider implicit cache。
# HINTS 控制是否主動發送 prompt_cache_key、cache_control、user_id 等已驗證 provider-specific hint；默認關閉。
# DIAGNOSTICS_LEVEL 可選 off/basic/debug；debug 也只輸出脫敏診斷，不記錄 raw prompt 或 request body。
# LLM_PROMPT_CACHE_TELEMETRY_ENABLED=true
# LLM_PROMPT_CACHE_HINTS_ENABLED=false
# LLM_PROMPT_CACHE_DIAGNOSTICS_LEVEL=off

# --- 多渠道配置（可選，也可在 Web 設置頁配置）---
# 每個渠道獨立配置 base_url / api_key / models，支持多 Key 輪詢與自動 fallback。
#
# 示例：DeepSeek + Gemini 雙渠道
# LLM_CHANNELS=deepseek,gemini
# LLM_DEEPSEEK_API_KEY=sk-xxx
# LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com
# LLM_DEEPSEEK_MODELS=deepseek-v4-flash,deepseek-v4-pro
# LLM_GEMINI_API_KEYS=key1,key2
# LLM_GEMINI_MODELS=gemini-3.6-flash
#
# 示例：自定義 API 端點（第三方代理 / 聚合平臺 / 轉發站）
# LLM_CHANNELS=my_proxy
# LLM_MY_PROXY_BASE_URL=https://your-proxy.example.com/v1
# LLM_MY_PROXY_API_KEY=sk-xxx
# LLM_MY_PROXY_MODELS=gpt-6.1-sol,claude-sonnet-4-6
# LLM_MY_PROXY_PROTOCOL=openai
#
# 示例：Ollama 本地模型（無需 API Key）
# LLM_CHANNELS=ollama
# LLM_OLLAMA_BASE_URL=http://localhost:11434
# LLM_OLLAMA_MODELS=qwen3:8b,llama3.2
#
# 示例：Hermes 本地 HTTP generation（Phase 3，僅普通分析/JSON；不支持 Agent tools、Stream、Vision）
# LLM_CHANNELS=hermes
# LLM_HERMES_PROTOCOL=openai
# LLM_HERMES_BASE_URL=http://127.0.0.1:8642/v1
# LLM_HERMES_API_KEY=sk-local-hermes
# LLM_HERMES_MODELS=hermes-agent
# LITELLM_MODEL=openai/hermes-agent
#
# 常用廠商模板（任選其一複製到 .env；完整說明見 docs/llm-providers.md）
#
# Modelflare（OpenAI Compatible）
# 註冊: https://modelflare.dev/sign-up?utm_source=github&utm_campaign=daily_stock_analysis
# 單渠道默認模型 gpt-6.1-sol；實際可用性以賬號權限、控制檯和連接測試為準。
# 只需配置此 Key，無需填寫渠道名、地址或模型：
MODELFLARE_KEY=
# 高級覆蓋（可選）：
# LLM_CHANNELS=modelflare
# LLM_MODELFLARE_API_KEY=sk-xxx
# 高級可選：LLM_MODELFLARE_MODELS=  # 顯式渠道列表優先，多渠道需分別聲明模型
# 可選覆蓋：LLM_MODELFLARE_BASE_URL=https://modelflare.dev/v1
# 可選協議：LLM_MODELFLARE_PROTOCOL=openai
# 默認協議 openai、接口 chat_completions；單渠道未配置主模型和模型列表時默認 gpt-6.1-sol。
#
# AIHubmix 聚合平臺（OpenAI Compatible）
# LLM_CHANNELS=aihubmix
# LLM_AIHUBMIX_PROTOCOL=openai
# LLM_AIHUBMIX_BASE_URL=https://aihubmix.com/v1
# LLM_AIHUBMIX_API_KEY=sk-xxx
# LLM_AIHUBMIX_MODELS=gpt-6.1-sol,claude-sonnet-4-6,gemini-3.6-flash
# LITELLM_MODEL=openai/gpt-6.1-sol
#
# OpenAI 官方
# LLM_CHANNELS=openai
# LLM_OPENAI_PROTOCOL=openai
# LLM_OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_OPENAI_API_KEY=sk-xxx
# LLM_OPENAI_MODELS=gpt-6.1-sol,gpt-6.1-terra
# LITELLM_MODEL=openai/gpt-6.1-sol
#
# DeepSeek 官方
# LLM_CHANNELS=deepseek
# LLM_DEEPSEEK_PROTOCOL=deepseek
# LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com
# LLM_DEEPSEEK_API_KEY=sk-xxx
# LLM_DEEPSEEK_MODELS=deepseek-v4-flash,deepseek-v4-pro
# LITELLM_MODEL=deepseek/deepseek-v4-flash
#
# Gemini 官方（官方協議，Base URL 留空）
# LLM_CHANNELS=gemini
# LLM_GEMINI_PROTOCOL=gemini
# LLM_GEMINI_API_KEY=xxx
# LLM_GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
# LITELLM_MODEL=gemini/gemini-3.6-flash
#
# Anthropic Claude 官方（官方協議，Base URL 留空）
# LLM_CHANNELS=anthropic
# LLM_ANTHROPIC_PROTOCOL=anthropic
# LLM_ANTHROPIC_API_KEY=sk-ant-xxx
# LLM_ANTHROPIC_MODELS=claude-sonnet-4-6,claude-opus-4-7
# LITELLM_MODEL=anthropic/claude-sonnet-4-6
#
# Kimi / Moonshot（OpenAI Compatible）
# LLM_CHANNELS=moonshot
# LLM_MOONSHOT_PROTOCOL=openai
# LLM_MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
# LLM_MOONSHOT_API_KEY=sk-xxx
# LLM_MOONSHOT_MODELS=kimi-k2.6,kimi-k2.5
# LITELLM_MODEL=openai/kimi-k2.6
#
# 通義千問 DashScope（OpenAI Compatible）
# LLM_CHANNELS=dashscope
# LLM_DASHSCOPE_PROTOCOL=openai
# LLM_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_DASHSCOPE_API_KEY=sk-xxx
# LLM_DASHSCOPE_MODELS=qwen3.6-plus,qwen3.6-flash
# LITELLM_MODEL=openai/qwen3.6-plus
#
# 智譜 GLM（OpenAI Compatible）
# LLM_CHANNELS=zhipu
# LLM_ZHIPU_PROTOCOL=openai
# LLM_ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_ZHIPU_API_KEY=xxx
# LLM_ZHIPU_MODELS=glm-5.1,glm-4.7-flash
# LITELLM_MODEL=openai/glm-5.1
#
# MiniMax（OpenAI Compatible）
# 來源：官方 OpenAI API 兼容文檔 https://platform.minimax.io/docs/api-reference/text-chat
# LiteLLM 通過 openai/<model> 路由到兼容 Chat Completions 的 Base URL。
# LLM_CHANNELS=minimax
# LLM_MINIMAX_PROTOCOL=openai
# LLM_MINIMAX_BASE_URL=https://api.minimax.io/v1
# LLM_MINIMAX_API_KEY=xxx
# LLM_MINIMAX_MODELS=MiniMax-M2.7,MiniMax-M2.7-highspeed
# LITELLM_MODEL=openai/MiniMax-M2.7
#
# 小米 MiMo（OpenAI Compatible）
# Base URL 與模型名請以 MiMo 官方文檔/控制檯為準。
# LLM_CHANNELS=mimo
# LLM_MIMO_PROTOCOL=openai
# LLM_MIMO_BASE_URL=
# LLM_MIMO_API_KEY=sk-xxx
# LLM_MIMO_MODELS=mimo-xxx
# LITELLM_MODEL=openai/mimo-xxx
# 注：倉庫默認 daily_analysis workflow 未顯式透傳 LLM_MIMO_*，該示例默認適用於本地 .env、Docker 或自託管腳本；Actions 使用請同步補齊 workflow 映射。
#
# 火山方舟 / 豆包（OpenAI Compatible，按實際開通地域調整 endpoint）
# 來源：火山方舟在線推理 / Responses API 文檔 https://www.volcengine.com/docs/82379/2121998
# LiteLLM 通過 openai/<model> 路由到兼容 Chat Completions 的 Base URL。
# LLM_CHANNELS=volcengine
# LLM_VOLCENGINE_PROTOCOL=openai
# LLM_VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_VOLCENGINE_API_KEY=xxx
# LLM_VOLCENGINE_MODELS=doubao-seed-1-6-251015,doubao-seed-1-6-thinking-251015
# LITELLM_MODEL=openai/doubao-seed-1-6-251015
#
# 硅基流動 SiliconFlow（OpenAI Compatible）
# 來源：官方模型列表 https://docs.siliconflow.cn/quickstart/models
# LLM_CHANNELS=siliconflow
# LLM_SILICONFLOW_PROTOCOL=openai
# LLM_SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# LLM_SILICONFLOW_API_KEY=sk-xxx
# LLM_SILICONFLOW_MODELS=deepseek-ai/DeepSeek-V3.2,Qwen/Qwen3-235B-A22B-Thinking-2507
# LITELLM_MODEL=openai/deepseek-ai/DeepSeek-V3.2
#
# OpenRouter（OpenAI Compatible）
# 來源：官方 Models API https://openrouter.ai/docs/api/api-reference/models/get-models
# LLM_CHANNELS=openrouter
# LLM_OPENROUTER_PROTOCOL=openai
# LLM_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# LLM_OPENROUTER_API_KEY=sk-or-xxx
# LLM_OPENROUTER_MODELS=~anthropic/claude-sonnet-latest,~openai/gpt-latest
# LITELLM_MODEL=openai/~anthropic/claude-sonnet-latest
#
# Requesty（OpenAI Compatible）
# 來源：官方 Models API https://docs.requesty.ai/api-reference/endpoint/models-list
# 示例模型為無斜槓的 managed 模型 ID；Base URL 指向 requesty.ai 時，vendor/model ID（如 anthropic/claude-sonnet-4-6）會自動補上 openai/ 網關路由並原樣發送，Web「獲取模型」勾選後保存為 openai/<vendor>/<model>。
# openai/ 開頭的 ID 與 LiteLLM 路由前綴重名，手動填寫時需寫成 openai/openai/gpt-4o-mini。
# EU 區域可將 Base URL 改為 https://router.eu.requesty.ai/v1。
# LLM_CHANNELS=requesty
# LLM_REQUESTY_PROTOCOL=openai
# LLM_REQUESTY_BASE_URL=https://router.requesty.ai/v1
# LLM_REQUESTY_API_KEY=xxx
# LLM_REQUESTY_MODELS=claude-sonnet-4-6,gpt-6.1-sol
# LITELLM_MODEL=openai/claude-sonnet-4-6

# Anspire Open 兼容示例（共享搜索與 LLM Key，OpenAI Compatible）
# LLM_CHANNELS=anspire
# LLM_ANSPIRE_PROTOCOL=openai
# LLM_ANSPIRE_BASE_URL=https://open-gateway.anspire.cn/v6  # 示例網關
# LLM_ANSPIRE_API_KEY=sk-xxx
# LLM_ANSPIRE_MODELS=Doubao-Seed-2.0-lite,Doubao-Seed-2.0-pro  # 示例模型
# LITELLM_MODEL=openai/Doubao-Seed-2.0-lite  # 示例主模型

# 高級：模型路由 YAML 配置（可選，參考 docs/examples/litellm_config.example.yaml）
# LITELLM_CONFIG=./litellm_config.yaml

# ===================================
# 搜索引擎配置（用於獲取股票新聞）
# ===================================
# Bocha API Keys（中文搜索優化，支持AI摘要，支持多個，逗號分隔）
# 獲取: https://open.bocha.cn/
# BOCHA_API_KEYS=your_bocha_key_here
# MiniMax API Key（Coding Plan Web Search，支持多個，逗號分隔）
# 獲取: https://platform.minimax.io/
# MINIMAX_API_KEYS=your_minimax_key_here
# Tavily API Keys（支持多個，逗號分隔）
TAVILY_API_KEYS=
# SerpAPI Keys（支持多個，逗號分隔）
SERPAPI_API_KEYS=

# Anspire Open（可選兼容服務；已有 Key 可繼續使用，搜索順序位於 SerpAPI 之後）
# 獲取: https://open.anspire.cn/?share_code=QFBC0FYC
# 在未配置更高優先級 OpenAI-compatible 來源時，滿足條件可複用該 key 給 Anspire 大模型網關與新聞搜索。
# 下列網關與模型為當前項目示例配置；是否可用請以 Anspire 控制檯與官方文檔為準：
# 示例網關： https://open-gateway.anspire.cn/v6
# 示例模型：Doubao-Seed-2.0-lite（可覆蓋為 ANSPIRE_LLM_MODEL=Doubao-Seed-2.0-pro）
# 若網關有區域/版本差異，可覆蓋為 ANSPIRE_LLM_BASE_URL=https://open-gateway.anspire.ai/v6
ANSPIRE_API_KEYS=
# ANSPIRE_LLM_MODEL=Doubao-Seed-2.0-lite
# ANSPIRE_LLM_BASE_URL=https://open-gateway.anspire.cn/v6
# ANSPIRE_LLM_ENABLED=true

# Brave Search API Keys（支持多個，逗號分隔）
# 獲取: https://brave.com/search/api/
BRAVE_API_KEYS=
# SearXNG 實例地址（逗號分隔，私有部署無配額，需在 settings.yml 啟用 format: json）
# GitHub Actions 每日分析工作流支持同名 Variables 優先、Secrets 回退；公網地址可配置為 Variable。
# 留空且下方開關為 true 時，會自動從 searx.space 拉取公共實例。公共實例普遍存在限流（429）、
# 下線（503）或未開啟 JSON 輸出的情況，逐個重試會讓每次分析多耗 30~60 秒且新聞面最終為空，
# 因此默認關閉。推薦配置自建實例地址（SEARXNG_BASE_URLS），或使用上方任一帶 key 的搜索渠道。
SEARXNG_BASE_URLS=
SEARXNG_PUBLIC_INSTANCES_ENABLED=false
# 自建 SearXNG 單次搜索超時（秒，默認 10，最小 1）；公共實例不受此配置影響
SEARXNG_TIMEOUT_SECONDS=10

# ===================================
# Social Sentiment Intelligence (US stocks only)
# ===================================
# Reddit / X (Twitter) / Polymarket sentiment data from api.adanos.org
# Only activates for US stock tickers (AAPL, TSLA, etc.), ignored for A-shares/HK stocks
# Free tier: 250 requests/month | Register: https://api.adanos.org
# SOCIAL_SENTIMENT_API_KEY=sk_live_your_key_here
# SOCIAL_SENTIMENT_API_URL=https://api.adanos.org

# ===================================
# 新聞時效與分析篩選配置
# ===================================
# 新聞策略窗口檔位：ultra_short(1天) / short(3天) / medium(7天) / long(30天)
# 實際窗口 = min(策略窗口, NEWS_MAX_AGE_DAYS)
# NEWS_STRATEGY_PROFILE=short
# 新聞最大時效（天），搜索時限制結果在近期內，避免使用過時信息
# NEWS_MAX_AGE_DAYS=3
# 本地資訊/情報池保留天數；只清理資訊池 intelligence_items，不影響歷史報告
# NEWS_INTEL_RETENTION_DAYS=30
# 單個 RSS/Atom 資訊源拉取超時（秒）
# NEWS_INTEL_FETCH_TIMEOUT_SEC=8
# 單次每個資訊源最多采集條數
# NEWS_INTEL_MAX_ITEMS_PER_SOURCE=50
# 開啟後在個股分析、Agent 分析和大盤覆盤讀取本地資訊池前，自動初始化內置資訊源並拉取啟用源；
# 默認關閉，避免未確認的外部請求和分析輸入變化
# 注：倉庫默認 daily_analysis workflow 未顯式透傳該變量，Actions 使用請同步補齊 workflow 映射
# NEWS_INTEL_AUTO_FETCH_ENABLED=false
# NewsNow HTTP API 基地址 —— 外部依賴配置
# - 官方項目及部署指南：https://github.com/qqhann/newsnow
# - 當前默認值 https://newsnow.busiyi.world 是公開示例實例，存在以下風險：
#   * 可能因官方維護或限流而不可用
#   * 不保證穩定性或數據可靠性，僅用於演示和測試
# - 生產環境強烈建議改為自建 NewsNow 實例，確保可控和穩定性
# - 部署前建議驗證 API 契約兼容性（參見 docs/intelligence-sources.md）：
#   curl -sS "https://newsnow.busiyi.world/api/s?id=cls-hot" | python -c "import sys, json; data=json.load(sys.stdin); assert isinstance(data.get('items'), list)"
# - 本配置僅控制資訊源採集與清理行為，不會改變 LLM / provider / base URL / 兼容回退語義
# NEWSNOW_BASE_URL=https://newsnow.busiyi.world
# 乖離率閾值（%），偏離 MA5 超過此值提示不追高；強勢趨勢股自動放寬到 1.5 倍
# BIAS_THRESHOLD=5.0

# ===================================
# Agent 策略對話配置（Web 對話頁）
# ===================================
# 啟用 Agent 策略對話（默認 false，內部統一命名為 skill）
# AGENT_MODE=true
# 默認模型問股的主模型（可選）：留空時繼承主模型；無 provider 前綴會按 openai/<model> 解析；Codex 不使用此項
# AGENT_LITELLM_MODEL=
# Agent 資源上限：默認模型用作推理步數上限（默認 10 時各子 Agent 按自身預設運行）；Codex 用作單次問股的工具調用次數上限
# AGENT_MAX_STEPS=10
# 默認啟用策略（逗號分隔），不配置時使用以下內置默認值
#
# 內置策略技能列表（可任意組合）：
#   bull_trend          — 多頭趨勢（MA5>MA10>MA20 排列 + 低乖離率）
#   ma_golden_cross     — 均線金叉（MA5 上穿 MA10/MA20）
#   volume_breakout     — 放量突破（價格突破近期高點 + 成交量放大）
#   hot_theme           — 熱點題材（政策/產業熱點、板塊擴散與個股相關性）
#   event_driven        — 事件驅動（業績、政策、訂單、併購等催化事件）
#   growth_quality      — 成長質量（收入利潤、ROE、現金流與成長持續性）
#   expectation_repricing — 預期重估（業績/政策/估值預期差修復或落空）
#   shrink_pullback     — 縮量回踩（回踩均線 + 量能萎縮，低吸點）
#   bottom_volume       — 底部放量（地量見地價，底部反轉信號）
#   dragon_head         — 龍頭策略（強勢龍頭，趨勢延續追漲）
#   one_yang_three_yin  — 一陽夾三陰（主力洗盤後強勢反包形態）
#   box_oscillation     — 箱體震盪（區間高拋低吸）
#   chan_theory          — 纏論（纏中說禪理論：筆/線段/中樞）
#   wave_theory         — 波浪理論（艾略特波浪計數）
#   emotion_cycle       — 情緒週期（市場情緒高低點輪動）
#
# 留空時，系統會使用 metadata 裡聲明的主默認策略 skill（內置默認是 bull_trend）
# AGENT_SKILLS=
#
# 也可以手動指定一組策略：
# AGENT_SKILLS=bull_trend,ma_golden_cross,shrink_pullback
#
# 完整啟用所有內置策略（兩種寫法等效）：
# AGENT_SKILLS=all
# AGENT_SKILLS=bull_trend,ma_golden_cross,volume_breakout,hot_theme,event_driven,growth_quality,expectation_repricing,shrink_pullback,bottom_volume,dragon_head,one_yang_three_yin,box_oscillation,chan_theory,wave_theory,emotion_cycle
#
AGENT_SKILLS=
# 自定義策略目錄（可選，放置自定義 YAML 策略文件；環境變量名沿用內部 skill 命名）
# AGENT_SKILL_DIR=./strategies

# Agent 架構模式（默認 single；multi 為多 Agent 編排模式）
# AGENT_ARCH=single

# Multi-Agent 編排模式（僅 AGENT_ARCH=multi 時有效）
# quick: 技術分析→決策（最快，約 2 次 LLM 調用）
# standard: 技術→情報→決策（默認）
# full: 技術→情報→風控→決策
# specialist: 技術→情報→風控→策略專家評估→決策
# AGENT_ORCHESTRATOR_MODE=standard

# Agent 執行超時預算（秒；默認 LiteLLM 路徑可用 0 關閉；Codex 必須大於 0，確保每次問股都會結束；默認 600）
# AGENT_ORCHESTRATOR_TIMEOUT_S=600

# 子 Agent 獨立超時上限（秒，0=關閉；設為正值如 180 可為該 Agent 啟用獨立硬上限）
# 生效規則：
#   - Pipeline 總預算關閉（AGENT_ORCHESTRATOR_TIMEOUT_S=0）時：子 Agent 上限獨立生效，作為該 Agent 的絕對超時
#   - Pipeline 總預算開啟時：實際上限 = min(Pipeline 剩餘預算, 子 Agent 上限)，取兩者中較小值
#   - 未配置（默認 0）時：無獨立上限，僅受 Pipeline 剩餘預算約束
# AGENT_TECHNICAL_AGENT_TIMEOUT_S=0
# AGENT_INTEL_AGENT_TIMEOUT_S=0
# AGENT_RISK_AGENT_TIMEOUT_S=0
# AGENT_DECISION_AGENT_TIMEOUT_S=0
# AGENT_PORTFOLIO_AGENT_TIMEOUT_S=0
# AGENT_SKILL_AGENT_TIMEOUT_S=0

# Agent 工具按類別默認超時（秒，0=關閉；未配置時回退到全局 tool_call_timeout_seconds 預算）
# 有效超時按 first-wins 解析：顯式 per-run tool_call_timeout_seconds > 單工具顯式 timeout_seconds > 類別默認值 > 無限制；
# 剩餘 wall-clock 預算僅作不可突破的外層 cap；inf/nan/負數視為無限制。
# market 類工具（get_market_indices / get_sector_rankings 等網絡數據調用）複用 AGENT_DATA_TOOL_TIMEOUT_S，無獨立開關。
# AGENT_DATA_TOOL_TIMEOUT_S=0
# AGENT_SEARCH_TOOL_TIMEOUT_S=0
# AGENT_ANALYSIS_TOOL_TIMEOUT_S=0
# AGENT_ACTION_TOOL_TIMEOUT_S=0

# 策略專家併發數（僅 specialist 模式生效；範圍 1-4，默認 3）
# AGENT_SKILL_CONCURRENCY=3

# 風控 Agent 是否可以否決買入信號（默認開啟）
# AGENT_RISK_OVERRIDE=true

# 記憶與校準系統（追蹤歷史準確率，自動調節置信度）
# AGENT_MEMORY_ENABLED=false

# 基於樣本充足的真實 Skill Outcome 保守加權策略意見
# AGENT_SKILL_AUTOWEIGHT=true

# 策略路由模式（auto=根據市場狀態自動選擇 / manual=使用 AGENT_SKILLS 列表）
# AGENT_SKILL_ROUTING=auto

# 問股可見對話上下文壓縮（默認關閉）。開啟後僅壓縮用戶可見的 user/assistant 歷史，不影響同輪 tool/thinking 透傳。
# AGENT_CONTEXT_COMPRESSION_ENABLED=false
# 壓縮策略：cost=更省 token / balanced=均衡 / long_context_raw_first=優先保留更多原文
# AGENT_CONTEXT_COMPRESSION_PROFILE=balanced
# 觸發壓縮的歷史 token 閾值；留空則跟隨當前 profile preset
# AGENT_CONTEXT_COMPRESSION_TRIGGER_TOKENS=
# 壓縮時最近 N 個用戶輪次及其後的回覆保持原文；留空則跟隨當前 profile preset
# AGENT_CONTEXT_PROTECTED_TURNS=

# 事件告警監控（schedule 模式後臺輪詢；觸發後複用已配置通知渠道）
# 兼容性說明：本節僅新增告警規則配置，不會修改模型名、provider、Base URL、LiteLLM 或 LLM 配置語義；回退只需關閉/移除事件監控配置。
# legacy JSON 僅支持三類 single-symbol 基礎規則；技術指標、自選股、持倉/賬戶、大盤紅綠燈規則請使用 Web/API 告警中心配置。
# legacy JSON 支持規則：
#   price_cross          — 價格突破閾值，direction: above / below，字段: price
#   price_change_percent — 漲跌幅閾值，direction: up / down，字段: change_pct（單位：%）
#   volume_spike         — 成交量放大，字段: multiplier（相對近 20 日均量倍數）
# AGENT_EVENT_MONITOR_ENABLED=false
# AGENT_EVENT_MONITOR_INTERVAL_MINUTES=5
# AGENT_EVENT_ALERT_RULES_JSON=[{"stock_code":"600519","alert_type":"price_cross","direction":"above","price":1800},{"stock_code":"300750","alert_type":"price_change_percent","direction":"down","change_pct":3.0},{"stock_code":"000858","alert_type":"volume_spike","multiplier":2.5}]
# ====== 釘釘機器人 (DingTalk) ======
# 釘釘群機器人的 Webhook URL
DINGTALK_WEBHOOK_URL=
# 釘釘機器人的加簽密鑰 (SEC 開頭的字符串)，如果未開啟加簽可為空
DINGTALK_SECRET=
# ===================================
# 通知渠道配置（可同時配置多個，全部推送）
# ===================================
#
# 【方式一】企業微信機器人
# 在企業微信群 -> 設置 -> 群機器人 -> 添加 -> 複製 Webhook 地址
#
# WECHAT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your_key_here
#
# 【方式二】飛書機器人（二選一）
#
# 方式 2a — 群自定義機器人 Webhook
# 在飛書群 -> 設置 -> 群機器人 -> 添加機器人 -> 自定義機器人 -> 複製 Webhook 地址
#
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your_key_here
# 如果機器人安全設置開啟了“簽名校驗”，需同步填寫 secret
# FEISHU_WEBHOOK_SECRET=your_feishu_webhook_secret
# 如果機器人安全設置開啟了“關鍵詞”，需填寫同一個關鍵詞；系統會自動在每條消息前補上
# FEISHU_WEBHOOK_KEYWORD=股票日報
#
# 方式 2b — 飛書應用機器人（App Bot）推送
# 在飛書開放平臺創建應用，開啟 im:message 權限併發布。
#
# 群聊模式（推薦）：將機器人拉入目標群，從群設置中獲取 chat_id
# FEISHU_APP_ID=cli_xxxxxxxxxxxxx
# FEISHU_APP_SECRET=your_app_secret
# FEISHU_CHAT_ID=oc_xxxxxxxxxxxxx
# FEISHU_RECEIVE_ID_TYPE=chat_id
#
# 私聊模式：直接給指定用戶發私信。用戶的 open_id 從機器人事件或聯繫人 API 獲取。
# FEISHU_APP_ID=cli_xxxxxxxxxxxxx
# FEISHU_APP_SECRET=your_app_secret
# FEISHU_CHAT_ID=ou_xxxxxxxxxxxxx
# FEISHU_RECEIVE_ID_TYPE=open_id
# FEISHU_DOMAIN=feishu  # 域名: feishu(飛書國內) / lark(國際版 larksuite.com)
#
# 【方式三】Telegram 機器人（需同時配置兩項）
# 1. 在 Telegram 找 @BotFather -> /newbot -> 獲取 Bot Token
# 2. 獲取 Chat ID：發消息給 @userinfobot 或訪問 https://api.telegram.org/bot<token>/getUpdates
#
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# TELEGRAM_CHAT_ID=123456789
# TELEGRAM_MESSAGE_THREAD_ID=2780
#
# 【方式四】郵件推送（只需 2 項配置，SMTP 自動識別）
# 支持 QQ郵箱、163郵箱、Gmail 等支持 SMTP 授權碼/基礎認證的郵箱
# Outlook / Exchange 若租戶強制 OAuth2，當前版本暫不支持
# 1. 獲取授權碼（以QQ郵箱為例）：設置 -> 賬戶 -> POP3/SMTP服務 -> 開啟 -> 獲取授權碼
# 2. 填寫下面兩項即可：
#
# EMAIL_SENDER=
# EMAIL_PASSWORD=
# EMAIL_RECEIVERS=receiver@example.com  # 可選，留空則發給自己
#
# 【方式四擴展】股票分組發往不同郵箱（Issue #268，可選）
# STOCK_LIST 決定實際分析範圍；STOCK_GROUP_N 僅決定郵件發給誰，建議始終寫成 STOCK_LIST 的子集
# Telegram / 企業微信 / Webhook 等其他渠道仍會按完整 STOCK_LIST 推送，不會因為分組而拆分
# 當前倉庫默認 GitHub Actions daily_analysis workflow 不會自動注入任意編號的 STOCK_GROUP_N / EMAIL_GROUP_N
# 因此該能力適用於本地 .env、Docker，或其他已顯式注入這些變量的運行環境
# STOCK_GROUP_1=600519,300750
# EMAIL_GROUP_1=user1@example.com
# STOCK_GROUP_2=002594,AAPL
# EMAIL_GROUP_2=user2@example.com
#
# 【方式五】自定義 Webhook（支持多個，逗號分隔）
# 適用於：釘釘、Discord、Slack、Bark、自建服務等任意支持 POST JSON 的 Webhook
# 系統會自動識別常見服務並使用對應格式
#
# CUSTOM_WEBHOOK_URLS=https://oapi.dingtalk.com/robot/send?access_token=xxx,https://hooks.slack.com/services/xxx
# CUSTOM_WEBHOOK_BEARER_TOKEN=  # 可選，用於需要認證的 Webhook (Header Authorization: Bearer <token>)
# CUSTOM_WEBHOOK_BODY_TEMPLATE=  # 可選，全局 JSON body 模板，會覆蓋 Bark/Slack/Discord 等自動 payload；推薦 $content_json/$title_json
# Docker Compose 手寫 .env 時請寫成 $$content_json/$$title_json；Web 設置頁會自動轉義，運行時仍還原為單個 $
# WEBHOOK_VERIFY_SSL=true   # 默認校驗；影響讀取該配置的 webhook-style HTTPS 通知請求。設為 false 可支持自簽名證書。警告：禁用後存在 MITM 劫持風險，僅限可信內網
#
# 【方式六】Pushover 配置
# 註冊Pushover賬號，並創建應用Token https://pushover.net/apps/build
# PUSHOVER_USER_KEY=
# PUSHOVER_API_TOKEN=
#
# 【方式六擴展】ntfy 配置
# NTFY_URL 必須包含 topic path，例如 https://ntfy.sh/my-topic 或 https://self-hosted:port/my-topic
# 系統會解析 topic，並使用 ntfy JSON publish API 發送 Markdown 文本。
# NTFY_URL=
# NTFY_TOKEN=  # 可選，用於需要 Bearer Token 的 topic 或自建 ntfy server
#
# 【方式六擴展】Gotify 配置
# GOTIFY_URL 是 Gotify server base URL，不包含 /message；系統會拼接 /message 並用 X-Gotify-Key Header 發送 token。
# GOTIFY_URL=
# GOTIFY_TOKEN=  # Gotify application token
#
# 【方式七】PushPlus 配置（國內推送服務，推薦）
# 註冊PushPlus賬號並獲取Token https://www.pushplus.plus
# PUSHPLUS_TOKEN=
# 群組推送：填寫群組編碼後，消息推送給群組所有訂閱用戶（一對多）
# PUSHPLUS_TOPIC=
#
# 【方式八】Discord 配置
# 支持兩種方式：Webhook（推薦，配置簡單）和 Bot API（權限高）
# 
# 方式1：Discord Webhook（推薦，無需 Bot 賬號）
# 在 Discord 頻道設置 -> 集成 -> Webhook -> 新建 Webhook -> 複製 URL
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
# 
# 方式2：Discord Bot API（需要 Bot 賬號和頻道 ID）
# 1. 創建 Bot：https://discord.com/developers/applications -> 新建應用 -> Bot -> 創建 Bot
# 2. 獲取 Bot Token：Bot 頁面 -> 重置 Token
# 3. 獲取頻道 ID：Discord 開啟開發者模式 -> 右鍵頻道 -> 複製 ID
# DISCORD_BOT_TOKEN=
# DISCORD_MAIN_CHANNEL_ID=
# DISCORD_CHANNEL_ID=   # 兼容舊變量名，推薦改用 DISCORD_MAIN_CHANNEL_ID
# DISCORD_MAX_WORDS=2000 # Discord 單條 content 上限為 2000；運行時會自動截到不超過 2000 並分片發送長報告
# 如果你要接收 Discord Interaction / Webhook 回調，必須配置公鑰用於驗籤
# 獲取方式：Discord Developer Portal -> General Information -> Public Key
# DISCORD_INTERACTIONS_PUBLIC_KEY=
# 
# 【方式九】Slack 配置
# 支持兩種方式：Bot API（推薦）和 Incoming Webhook
# 同時配置時優先使用 Bot API，確保文本與圖片發送到同一頻道。
#
# 方式1：Slack Bot API（推薦，支持圖片上傳）
# 1. 創建 Slack App：https://api.slack.com/apps -> Create New App
# 2. 添加 Bot Token Scopes：chat:write, files:write
# 3. 安裝到工作區並獲取 Bot Token (xoxb-...)
# 4. 獲取頻道 ID：頻道詳情 -> 底部複製頻道 ID
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_CHANNEL_ID=C01234567
#
# 方式2：Slack Incoming Webhook（配置簡單，不支持圖片上傳）
# 在 Slack App 管理頁面創建 Incoming Webhook -> 複製 URL
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../xxx
#
# 【方式十】Server醬3 配置（國內推送服務，支持微信推送）
# 註冊Server醬3賬號並獲取SendKey https://sc3.ft07.com/
# SERVERCHAN3_SENDKEY=
#
# 【方式十一】AstrBot 配置
# ASTRBOT_URL=
# ASTRBOT_TOKEN=  # 可選，用於需要 Bearer Token 的 AstrBot Webhook
#
# 【高級配置】消息長度限制（字節）
# 超過限制會自動分批發送，一般無需修改
# FEISHU_MAX_BYTES=20000    # 飛書限制約 20KB，默認 20000 字節
# FEISHU_SEND_AS_FILE=false # 設為 true 時，飛書以文件形式發送報告（App Bot 模式），默認文字消息
# WECHAT_MAX_BYTES=4000     # 企業微信限制 4096 字節，默認 4000 字節
#
# 【Markdown 轉圖片】(Issue #455)
# 對不支持 Markdown 的渠道，將報告轉為圖片發送，提升可讀性
# 單股推送 + 圖片：需同時配置 MARKDOWN_TO_IMAGE_CHANNELS 且安裝轉圖工具
# MARKDOWN_TO_IMAGE_CHANNELS=telegram,wechat,custom,email,slack   # 逗號分隔
# MARKDOWN_TO_IMAGE_MAX_CHARS=15000   # 超過此長度不轉換，避免超大圖片
# MD2IMG_ENGINE=wkhtmltoimage   # wkhtmltoimage(默認) | markdown-to-file | playwright（需 Web 依賴和 npx playwright install chromium）
# 分享圖默認展示倉庫內置小紅書二維碼和暱稱 @霸天土小豆；以下配置可整體替換品牌信息
# SHARE_IMAGE_XIAOHONGSHU_URL=
# SHARE_IMAGE_XIAOHONGSHU_HANDLE=@霸天土小豆  # 全部配置留空時顯示內置暱稱
# SHARE_IMAGE_XIAOHONGSHU_QR_PATH=assets/my-xiaohongshu-qr.png  # 全部配置留空時使用內置二維碼
# 轉圖工具：wkhtmltopdf (apt install wkhtmltopdf / brew install wkhtmltopdf)，或 markdown-to-file
#
# 【通知路由策略】(Issue #1200 P3)
# 默認留空：該類型通知發送到所有已配置渠道。填寫後僅發送到列出的已配置渠道。
# 允許值：wechat,dingtalk,feishu,telegram,email,pushover,ntfy,gotify,pushplus,serverchan3,custom,discord,slack,astrbot
# NOTIFICATION_REPORT_CHANNELS=
# NOTIFICATION_ALERT_CHANNELS=
# NOTIFICATION_SYSTEM_ERROR_CHANNELS=
#
# 【通知降噪機制】(Issue #1200 P4)
# 默認全部關閉；僅影響靜態通知渠道，不影響機器人觸發會話回執。
# NOTIFICATION_DEDUP_TTL_SECONDS=0      # 同一穩定去重 key 在 TTL 內只發送一次；0 關閉
# NOTIFICATION_COOLDOWN_SECONDS=0       # 同一冷卻 key 在窗口內限頻；0 關閉
# NOTIFICATION_QUIET_HOURS=             # 靜默時段，格式 HH:MM-HH:MM，支持跨午夜
# NOTIFICATION_TIMEZONE=                # 靜默時段時區，如 Asia/Shanghai；留空跟隨 TZ/系統本地時區
# NOTIFICATION_MIN_SEVERITY=            # info,warning,error,critical；留空保持現狀
# NOTIFICATION_DAILY_DIGEST_ENABLED=false  # 預留配置；當前不會發送每日摘要
#
# 【實時行情預取】(Issue #455)
# PREFETCH_REALTIME_QUOTES=true   # 設為 false 可禁用，避免 efinance/akshare_em 全市場拉取；tushare 為單股接口，預取僅拉首股

# ===================================
# 單股推送配置（可選）
# ===================================
# 單股推送模式：每分析完一隻股票立即推送，而不是彙總後推送
# SINGLE_STOCK_NOTIFY=false
#
# 報告類型：simple(精簡)、full(完整)、brief(3-5句概括)
# Docker環境下如果推送內容不完整，可以設置為 full
# REPORT_TYPE=simple
# 報告輸出語言：zh(中文，默認) / en(英文) / ko(韓文)
# REPORT_LANGUAGE=zh
# 僅分析結果摘要：設為 true 時只推送彙總，不含個股詳情
# REPORT_SUMMARY_ONLY=false
# 通知報告底部顯示本次分析使用的 LLM 模型名稱；設為 false 可隱藏
# REPORT_SHOW_LLM_MODEL=true
#
# Report Engine P0 (Jinja2 / 完整性校驗 / 歷史對比)
# REPORT_TEMPLATES_DIR=templates
# REPORT_RENDERER_ENABLED=false
# REPORT_INTEGRITY_ENABLED=true
# REPORT_INTEGRITY_RETRY=1
# REPORT_HISTORY_COMPARE_N=0

# 個股分析與大盤覆盤合併推送（默認 false），減少郵件數量、降低垃圾郵件風險
# MERGE_EMAIL_NOTIFICATION=false

# ===================================
# 分析間隔配置（可選）
# ===================================
# 個股分析和大盤分析之間的延遲時間（秒）
# 用於避免觸發 Gemini 等 AI API 的限流
# ANALYSIS_DELAY=0

# 應用 AppKey（與 Webhook 模式共用）
DINGTALK_APP_KEY=xxxx
# 應用 AppSecret（與 Webhook 模式共用）
DINGTALK_APP_SECRET=xxxx
# 啟用 Stream 模式
DINGTALK_STREAM_ENABLED=false

# 飛書應用配置（用於 App Bot 主動推送 / Stream Bot / 雲文檔；不會直接開啟群 Webhook 推送）
FEISHU_APP_ID=xxxx
FEISHU_APP_SECRET=xxxx  # App Bot 主动推送还需 FEISHU_CHAT_ID；简单群推送优先使用 FEISHU_WEBHOOK_URL
# App Bot 主動推送目標；Stream Bot 或雲文檔不需要此項
# FEISHU_CHAT_ID=oc_xxxxxxxxxxxxx
# FEISHU_RECEIVE_ID_TYPE=chat_id
# 啟用長連接模式
FEISHU_STREAM_ENABLED=false
# 飛書群機器人 Webhook 安全配置（僅 Webhook 推送模式使用）
# FEISHU_WEBHOOK_SECRET=your_feishu_webhook_secret
# FEISHU_WEBHOOK_KEYWORD=股票日報

# 數據庫路徑
DATABASE_PATH=./data/stock_analysis.db
# SQLite 寫入優化：文件庫默認啟用 WAL，降低批量寫入和併發回寫時的鎖競爭
SQLITE_WAL_ENABLED=true
# SQLite 等鎖超時（毫秒）
SQLITE_BUSY_TIMEOUT_MS=5000
# SQLite 遇到 database is locked / database table is locked 時的最大重試次數
SQLITE_WRITE_RETRY_MAX=3
# SQLite 寫入重試基礎退避時間（秒，按指數退避遞增）
SQLITE_WRITE_RETRY_BASE_DELAY=0.1

# 分析歷史快照：設為 false 時不持久化整份 context_snapshot
# 包括 enhanced_context、market_phase_summary、AnalysisContextPack overview、diagnostics 和 raw snapshot 字段
SAVE_CONTEXT_SNAPSHOT=true

# ===================================
# 回測配置（可選）
# ===================================
# 是否啟用回測（true/false）
BACKTEST_ENABLED=true
# 回測評估窗口（交易日數）
BACKTEST_EVAL_WINDOW_DAYS=10
# 僅回測 N 天前的分析記錄（避免當天/最近數據不完整）
BACKTEST_MIN_AGE_DAYS=14
# 回測引擎版本（當回測邏輯升級時用於區分結果）
BACKTEST_ENGINE_VERSION=v1
# 中性區間閾值（%），例如 2 表示 -2%~+2% 視為震盪
BACKTEST_NEUTRAL_BAND_PCT=2.0

# ===================================
# ETF 輪動配置（可選，僅 python main.py --etf-rotation 使用）
# 規則說明見 docs/etf-rotation.md；以下均為默認值
# ===================================
# 風險池（逗號分隔）：滬深300/中證500/創業板/紅利低波/納指/黃金
# ETF_ROTATION_POOL=510300,510500,159915,512890,513100,518880
# 防守資產（貨幣 ETF），留空表示持有現金
# ETF_ROTATION_SAFE_ASSET=511880
# 動量窗口（交易日）
# ETF_ROTATION_LOOKBACK_DAYS=60
# 調倉頻率：weekly / monthly
# ETF_ROTATION_REBALANCE=weekly
# 最多同時持有幾隻
# ETF_ROTATION_TOP_N=2
# 換倉緩衝（百分點），已持有標的落後不超過該值時繼續持有
# ETF_ROTATION_SWITCH_BUFFER_PCT=2.0
# 單邊交易成本（bp）
# ETF_ROTATION_COST_BPS=10
# 回測歷史年數
# ETF_ROTATION_BACKTEST_YEARS=8

# === 定時任務配置 ===
# 建議僅保留一個調度入口；共享 DATABASE_PATH 的 CLI/Web 每日任務按計劃時刻去重
# 啟動立即執行和手動補跑不去重；認領後失敗需手動重試，詳見 docs/DEPLOY.md
# 是否啟用定時任務（true/false）
SCHEDULE_ENABLED=false
# 每日執行時間（HH:MM 格式，24小時制）
SCHEDULE_TIME=18:00
# 多時間執行列表（逗號分隔，留空時使用 SCHEDULE_TIME）
SCHEDULE_TIMES=
# Web/API runtime scheduler 單次分析硬超時（秒，最小 60 秒）
DSA_RUNTIME_SCHEDULER_TIMEOUT_SECONDS=2700
# 硬超時後是否推送已落庫個股的部分完成通知（true/false；默認 true，未設置即開啟，此前超時不推送）
DSA_TIMEOUT_PARTIAL_NOTIFY=true
# 定時模式啟動時是否立即執行一次分析（true/false）
# 若未顯式設置，定時模式會沿用 RUN_IMMEDIATELY 的運行時覆蓋語義以兼容舊配置
SCHEDULE_RUN_IMMEDIATELY=true
# 定時模式啟動立即執行的當日去重（true/false，默認 true）
# 啟動補跑前檢查標記文件（DATABASE_PATH 所在目錄，默認 data/analysis_run_state.json）：
# 當天已有成功且覆蓋當前應分析清單的全量分析（日期 + scope=full + 覆蓋面子集判定）則跳過，
# 否則照常執行；每日定時任務與手動/API 觸發永不去重；
# 標記缺失、損壞、schema 未知或覆蓋不全一律放行執行（絕不漏跑）；大盤覆盤完成度僅記錄、不參與判定
SCHEDULE_STARTUP_DEDUP=true
# 非定時模式啟動時是否立即執行一次分析（true/false）
RUN_IMMEDIATELY=true
# 是否啟用大盤覆盤（true/false）
MARKET_REVIEW_ENABLED=true
# 是否將大盤環境摘要注入個股分析 Prompt 並啟用保守護欄（true/false，默認開啟）
DAILY_MARKET_CONTEXT_ENABLED=true
# 大盤覆盤市場區域：cn(A股)、hk(港股)、us(美股)、jp(日股)、kr(韓股)、both(全部市場)；
# 支持逗號子集（如 cn,us,kr）；非法值/空值會回退為 cn。cn/hk/us/jp/kr 適合僅關注對應單區域的用戶
# MARKET_REVIEW_REGION=cn
# 大盤覆盤指數漲跌顏色：green_up=綠漲紅跌（默認），red_up=紅漲綠跌
# MARKET_REVIEW_COLOR_SCHEME=green_up

# ===================================
# 代理配置（可選）
# ===================================
# 是否啟用代理（true/false，默認 false）
# 僅在本地開發環境生效，GitHub Actions 環境自動跳過
USE_PROXY=false
# 代理服務器地址（默認 127.0.0.1）
PROXY_HOST=127.0.0.1
# 代理服務器端口（默認 10809）
PROXY_PORT=10809

# 系統配置
# 日誌目錄
LOG_DIR=./logs
# 日誌級別（DEBUG/INFO/WARNING/ERROR）
LOG_LEVEL=INFO
# LiteLLM 內部日誌級別（DEBUG/INFO/WARNING/ERROR/CRITICAL；默認 WARNING；排查內部流式/路由細節時可臨時設為 DEBUG）
# LITELLM_LOG_LEVEL=WARNING
# 最大併發線程數（建議保持低併發防封禁）
MAX_WORKERS=3
# 是否啟用調試日誌
DEBUG=false

# ===================================
# WebUI 配置（可選）
# ===================================
# 是否默認啟動 WebUI（true/false，默認 false）
WEBUI_ENABLED=false
# WebUI 監聽地址（默認 127.0.0.1；Docker/雲服務器需設為 0.0.0.0 才能外網訪問，詳見 docs/deploy-webui-cloud.md）
WEBUI_HOST=127.0.0.1
# WebUI 監聽端口（默認 8000）
WEBUI_PORT=8000
# 啟動 Web 服務前是否自動構建前端（npm install && npm run build，默認 true）
WEBUI_AUTO_BUILD=true
# 單層可信反向代理（如 Nginx → App）下信任 X-Forwarded-For 獲取真實 IP，取最右值用於登錄限流；多級代理/CDN 場景限流 key 可能退化為邊緣代理 IP，需額外評估；直連公網時保持 false 防偽造
# TRUST_X_FORWARDED_FOR=false

# ===================================
# Web 登錄認證（可選）
# ===================================
# 設為 true 啟用密碼保護；首次訪問時在網頁設置初始密碼，可在「系統設置 > 修改密碼」中修改
# 忘記密碼可在服務器執行: python -m src.auth reset_password
ADMIN_AUTH_ENABLED=false
# ADMIN_SESSION_MAX_AGE_HOURS=24  # Session 有效期（小時）

# ===================================
# 安全中間件 fastapi-guard（可選，默認關閉，修改後需重啟服務）
# ===================================
# 設為 true 後為 API/WebUI 增加按 IP 限流、IP 白/黑名單、請求特徵攔截與掃描器自動封禁；不替代上面的登錄失敗限流，二者疊加
# Set to true to add per-IP rate limiting, an IP allow/block list, request screening and automatic scanner bans.
# It complements (does not replace) the login failure limiter above. State is in memory, per process; no Redis needed.
# GUARD_ENABLED=false
# 每個 IP 在窗口內的最大請求數（含靜態資源與健康檢查）/ Max requests per IP per window (static assets and health checks count)
# GUARD_RATE_LIMIT=300
# GUARD_RATE_LIMIT_WINDOW=60
# IP 白名單（逗號分隔，支持 CIDR）；非空時只放行名單內 IP，其餘返回 403 / Allowlist (comma separated, CIDR ok); when set, every other IP gets 403 and listed IPs are exempt from the rate limit
# GUARD_WHITELIST=
# IP 黑名單（逗號分隔，支持 CIDR）/ Blocklist (comma separated, CIDR ok)
# GUARD_BLACKLIST=
# 僅當 TRUST_X_FORWARDED_FOR=true 時生效：可信反向代理地址，默認僅本機迴環；只有來自這些地址的連接才會採信 X-Forwarded-For 最右值，其它來源的該首部被忽略（登錄限流同樣取最右值，但不校驗代理來源）。啟用後內置啟動入口讓 Uvicorn 只信任同一組代理，TRUST_X_FORWARDED_FOR=false 時關閉 Uvicorn 的代理頭處理；反向代理後部署請設 TRUST_X_FORWARDED_FOR=true；自行用 uvicorn 命令啟動時請讓 FORWARDED_ALLOW_IPS 與此一致或加 --no-proxy-headers
# Only used when TRUST_X_FORWARDED_FOR=true: proxies allowed to set X-Forwarded-For (default loopback only). Only their rightmost entry is used; the header from any other peer is ignored (the login limiter also takes the rightmost entry but does not check the peer). With the guard on, the built-in entry points make Uvicorn trust the same proxies, or none when TRUST_X_FORWARDED_FOR=false; behind a reverse proxy set TRUST_X_FORWARDED_FOR=true; if you start uvicorn yourself, match FORWARDED_ALLOW_IPS to this list or pass --no-proxy-headers.
# GUARD_TRUSTED_PROXIES=127.0.0.1,::1
# 是否掃描請求體（默認 false，僅檢查路徑、查詢參數與請求頭）/ Also scan request bodies (default false: path, query and headers only)
# GUARD_SCAN_BODY=false
# 只記錄日誌不攔截，便於先觀察再啟用 / Log only, never block; useful for a trial run
# GUARD_PASSIVE_MODE=false

# ===========================================
# 圖片識別股票代碼（設置頁「從圖片添加」）
# ===========================================
# 單次請求超時 60 秒；圖片最大 5MB
# 需配置 GEMINI_API_KEY、ANTHROPIC_API_KEY 或 OPENAI_API_KEY 中至少一個（Vision 能力模型）

# ===========================================
# Data Fetcher Priority Configuration
# ===========================================
# Lower number = higher priority (tried first)
# Default priorities: efinance(0) > akshare(1) > tushare/pytdx(2) > baostock(3) > yfinance(4) > tencent(5)
# 上述優先級僅控制普通 A 股日 K 通用鏈路。
# IndexRegistry 已登記的滬深指數（當前為 sh000016、sh000688、sz399001、sz399006、sh000300）
# 固定按 Tencent > AkShare > TickFlow > YFinance 嘗試，不讀取這些 *_PRIORITY 配置；未配置或不可用的來源會跳過。
# 只有顯式市場輸入（如 sh000016 或 000016.SH）會觸發指數鏈；裸 000016 仍按股票處理。
# For US stocks, set YFINANCE_PRIORITY=0 to use Yahoo Finance first

# EFINANCE_PRIORITY=0      # EastMoney (China) - default: 0
# EFINANCE_CALL_TIMEOUT=30 # Timeout (seconds) for efinance API calls; prevents indefinite hangs
#                          # when eastmoney hosts are unreachable. Default: 30
# AKSHARE_PRIORITY=1       # AkShare (China) - default: 1
# TUSHARE_PRIORITY=2       # Tushare Pro (China) - default: 2
# TICKFLOW_PRIORITY=2      # TickFlow（普通 A 股日 K）- 默認：2；可選，需配置 TICKFLOW_API_KEY
# PYTDX_PRIORITY=2         # Tongdaxin (China) - default: 2
#
# Pytdx custom server (for intranet/deploy): use custom host instead of built-in public servers
# PYTDX_HOST=192.168.1.100
# PYTDX_PORT=7709
# Or multiple servers: PYTDX_SERVERS=ip1:port1,ip2:port2
# BAOSTOCK_PRIORITY=3      # Baostock (China) - default: 3
# YFINANCE_PRIORITY=4      # Yahoo Finance (Global) - default: 4
# TENCENT_PRIORITY=5       # Tencent direct daily K-line - ordinary A-share last-resort
#                          # fallback. Registered indices ignore this value. Default: 5

# Example: Prioritize Yahoo Finance for US stocks
# YFINANCE_PRIORITY=0
# EFINANCE_PRIORITY=99

# ===========================================
# 實時行情數據源優先級配置
# ===========================================
# 用於獲取量比、換手率、市盈率等實時數據
# 可選數據源（逗號分隔，按順序嘗試）：
#   - tencent: 騰訊財經，有量比/換手率/PE/PB，單股查詢穩定（推薦首選）
#   - akshare_sina: 新浪財經，基本行情，無量比，但非常穩定
#   - efinance: 東財(efinance庫)，有量比，全量拉取易被封
#   - akshare_em: 東財(akshare庫)，數據最全，全量拉取易被封
#   - tickflow: TickFlow，可選；排在優先級前兩位時支持按當前標的批量預取
#   - tushare: Tushare Pro，需要2000積分，數據全面（付費用戶推薦）
#
# 默認優先級：tencent > akshare_sina > efinance > akshare_em
# 如果有 Tushare Pro 高積分賬號，可將 tushare 放在首位：
# REALTIME_SOURCE_PRIORITY=tickflow,tencent,akshare_sina,efinance,akshare_em
# REALTIME_SOURCE_PRIORITY=tushare,tencent,akshare_sina,efinance,akshare_em
# REALTIME_SOURCE_PRIORITY=tencent,akshare_sina,efinance,akshare_em

# 是否啟用實時行情（關閉後使用歷史收盤價分析）
# ENABLE_REALTIME_QUOTE=true

# 盤中實時技術面：啟用時用實時價計算 MA/多頭排列（Issue #234）；關閉則用昨日收盤
# ENABLE_REALTIME_TECHNICAL_INDICATORS=true

# 是否啟用籌碼分佈（該接口不穩定，雲端部署建議關閉）
# ENABLE_CHIP_DISTRIBUTION=true

# 是否啟用基本面聚合（新增 P0 能力）
# ENABLE_FUNDAMENTAL_PIPELINE=true

# 基本面聚合性能與穩定性參數（單位：秒）
# FUNDAMENTAL_STAGE_TIMEOUT_SECONDS=8.0
# FUNDAMENTAL_FETCH_TIMEOUT_SECONDS=8.0
# FUNDAMENTAL_RETRY_MAX=1
# FUNDAMENTAL_CACHE_TTL_SECONDS=120
# FUNDAMENTAL_CACHE_MAX_ENTRIES=256

# ===========================================
# Portfolio P0: 導入 / 風險 / 匯率降級配置
# ===========================================
# PORTFOLIO_RISK_CONCENTRATION_ALERT_PCT=35.0
# PORTFOLIO_RISK_DRAWDOWN_ALERT_PCT=15.0
# PORTFOLIO_RISK_STOP_LOSS_ALERT_PCT=10.0
# PORTFOLIO_RISK_STOP_LOSS_NEAR_RATIO=0.8
# PORTFOLIO_RISK_LOOKBACK_DAYS=180
# PORTFOLIO_FX_UPDATE_ENABLED=true

# 東財接口補丁：東財/Efinance/Akshare 東方財富接口頻繁失敗（RemoteDisconnected、連接被關閉）時建議開啟
# 開啟後會注入 NID 令牌與隨機 User-Agent，降低被東財限流概率
# ENABLE_EASTMONEY_PATCH=false

# Optional FXMacroData authorization; public USD data works without a key.
FXMACRODATA_API_KEY=
