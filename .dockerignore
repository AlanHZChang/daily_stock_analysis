# 忽略 Python 緩存
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 忽略虛擬環境
venv/
.venv/
env/
.env
.env.*
!.env.example
.env.local

# 忽略 IDE
.idea/
.vscode/
*.swp
*.swo

# 忽略本地倉庫、CI 元數據和運行產物
.git/
.github/
.claude/reviews/
data/
logs/
reports/
*.log

# 忽略測試和文檔
tests/
test_*.py
*_test.py
docs/
*.md
!README.md

# 忽略不參與 Docker 鏡像構建的前端/桌面端產物
apps/dsa-desktop/
node_modules/
dist/
build/
coverage/
apps/dsa-web/node_modules/
apps/dsa-web/dist/
apps/dsa-web/build/
apps/dsa-web/coverage/
